{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "types": ["node"],
    "incremental": false,
    "plugins": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
